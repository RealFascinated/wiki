{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Options from @docusaurus/tsconfig are inlined because it still sets `baseUrl`,
  // which TypeScript 7 no longer supports.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
